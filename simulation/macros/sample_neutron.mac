# Balanced ML-development sample: single neutrons.
/warptrack/output/file sample_neutron.root
/warptrack/source sample
/warptrack/sample/particle neutron
/warptrack/sample/minEnergy 1 MeV
/warptrack/sample/maxEnergy 10 GeV
/warptrack/sample/halfWidthX 200 mm
/warptrack/sample/halfWidthY 400 mm
/warptrack/sample/maxTheta 30 deg
/warptrack/sample/logEnergy 1
/run/beamOn 10000
