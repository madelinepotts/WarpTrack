# Balanced ML-development sample: single muons.
# The randomized source uses a cos(theta)-weighted downward angular distribution,
# uniform x/y source positions, and log-uniform kinetic energy.
/warptrack/source sample
/warptrack/sample/particle mu-
/warptrack/sample/minEnergy 30 MeV
/warptrack/sample/maxEnergy 10 GeV
/warptrack/sample/halfWidthX 200 mm
/warptrack/sample/halfWidthY 400 mm
/warptrack/sample/maxTheta 30 deg
/warptrack/sample/logEnergy 1
/run/beamOn 10000
